# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key (secret!)

# ── Email (optional — Ethereal is used automatically if not set) ──────────────
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password    # Google App Password, not your login password

# ── Frontend URL (used in emails) ────────────────────────────────────────────
FRONTEND_URL=https://YOUR_PROJECT.vercel.app

# ── Vite (frontend) — prefix with VITE_ to expose to the browser ─────────────
# Only the anon/public key goes here — never the service role key
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...    # anon/public key
